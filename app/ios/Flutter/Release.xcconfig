#include "Generated.xcconfig"

// Rust 核心以 staticlib 連結(iOS 不能 dlopen 隨附 dylib);
// -force_load 保住 Swift 端沒引用的 FFI 符號,dart:ffi 才查得到。
// Security:vault key 存 Keychain(Rust 直接呼叫 SecItem*,staticlib 不會自動帶 framework)
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -force_load $(PROJECT_DIR)/../../core/target/aarch64-apple-ios/release/libtterm_ffi.a -framework Security
OTHER_LDFLAGS[sdk=iphonesimulator*] = $(inherited) -force_load $(PROJECT_DIR)/../../core/target/aarch64-apple-ios-sim/release/libtterm_ffi.a -framework Security

// export _tterm_*:沒有這行,release 的 dead-strip 會把沒被 Swift 引用的
// FFI 符號整批剝掉(force_load 也擋不住),dlsym 就查不到了
EXPORTED_SYMBOLS_FILE = $(PROJECT_DIR)/Runner/exported_symbols.txt

// archive(flutter build ipa)會再跑一次 strip,預設 all 連 export 表都剝光,
// 上架版一開就查不到 tterm_*;只剝非全域符號才留得住。
// flutter build ios 不走 archive 的 strip,所以光看那份檢查不出來。
STRIP_STYLE = non-global
